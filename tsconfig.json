{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "declaration": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["index.d.ts", "binding.d.ts", "__test__/**/*"]
}
