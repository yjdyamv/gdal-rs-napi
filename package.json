{
  "name": "gdal-rs-napi",
  "version": "0.1.0",
  "description": "Node.js bindings for GDAL, built on the gdal / gdal-sys Rust crates with a self-contained static GDAL + PROJ",
  "keywords": [
    "gdal",
    "gis",
    "geospatial",
    "raster",
    "vector",
    "geotiff",
    "napi-rs",
    "rust"
  ],
  "license": "MIT",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "async-methods.js",
    "compat/",
    "binding.js",
    "binding.d.ts",
    "assets/",
    "CHANGELOG.md",
    "README.zh-CN.md"
  ],
  "engines": {
    "node": ">= 20.17.0"
  },
  "napi": {
    "binaryName": "gdal-rs-napi",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs --platform --release --js binding.js --dts binding.d.ts",
    "build:debug": "node scripts/build.mjs --platform --js binding.js --dts binding.d.ts",
    "pack": "node scripts/pack-platform.mjs",
    "pack:npm": "node scripts/pack-packages.mjs",
    "lgpl": "node scripts/lgpl-geos.mjs",
    "smoke": "node scripts/smoke-install.mjs",
    "test": "node --test",
    "gdalinfo": "node examples/gdalinfo.mjs",
    "to-cog": "node examples/to-cog.mjs",
    "to-vector": "node examples/convert-vector.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yjdyamv/gdal-rs-napi.git"
  }
}
